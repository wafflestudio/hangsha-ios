# Native provider SDK configuration embedded in the app bundle.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
EXPO_PUBLIC_NAVER_CLIENT_ID=
EXPO_PUBLIC_NAVER_CLIENT_SECRET=

# Optional. Must match the URL scheme configured in Naver Developers.
EXPO_PUBLIC_NAVER_URL_SCHEME=hangsha-naver

# Must match the bundle identifier registered with each provider.
IOS_BUNDLE_IDENTIFIER=com.anonymous.hangsha-ios
